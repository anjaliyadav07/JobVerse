<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Find Jobs | JobVerse</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<nav class="navbar">
    <div class="logo">
        <a href="/">
            <img src="/images/jobverse-logo.png" alt="JobVerse">
        </a>
    </div>

    <div class="nav-links">
        <a href="/">Home</a>
        <a href="/jobs" class="active">Find Jobs</a>
        <a href="/companies">Companies</a>
        <a href="/about">About</a>
    </div>

    <div class="nav-actions">
        <a href="/login" class="login-btn">Log In</a>
        <a href="/register" class="signup-btn">Sign Up</a>
    </div>
</nav>

<main class="jobs-page-v2">

    <!-- HERO -->
    <section class="jobs-v2-hero">
        <div class="jobs-v2-hero-inner">

            <div class="jobs-v2-hero-copy">
                <span class="jobs-v2-eyebrow">
                    <span class="jobs-v2-eyebrow-dot"></span>
                    JOB OPPORTUNITIES
                </span>

                <h1>
                    Find your next
                    <span>opportunity.</span>
                </h1>

                <p>
                    Search roles that match your skills, goals, and ambitions.
                </p>
            </div>

            <div class="jobs-v2-stats">
                <div class="jobs-v2-stat">
                    <div class="jobs-v2-stat-icon">▣</div>
                    <div>
                        <strong>10K+</strong>
                        <span>Job Opportunities</span>
                    </div>
                </div>

                <div class="jobs-v2-stat">
                    <div class="jobs-v2-stat-icon">▥</div>
                    <div>
                        <strong>500+</strong>
                        <span>Companies</span>
                    </div>
                </div>

                <div class="jobs-v2-stat">
                    <div class="jobs-v2-stat-icon">♙</div>
                    <div>
                        <strong>100K+</strong>
                        <span>Students & Professionals</span>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- SEARCH -->
    <section class="jobs-v2-search-wrap">
        <form action="/jobs" method="GET" class="jobs-v2-search">

            <div class="jobs-v2-field">
                <label for="keyword">Keyword</label>
                <div class="jobs-v2-input">
                    <span class="jobs-v2-input-icon">⌕</span>
                    <input
                        type="text"
                        id="keyword"
                        name="keyword"
                        value="<%= keyword %>"
                        placeholder="Job title, skill or keyword"
                    >
                </div>
            </div>

            <div class="jobs-v2-field">
                <label for="location">Location</label>
                <div class="jobs-v2-input">
                    <span class="jobs-v2-input-icon">⌖</span>
                    <input
                        type="text"
                        id="location"
                        name="location"
                        value="<%= location %>"
                        placeholder="India, Remote, Bangalore"
                    >
                </div>
            </div>

            <div class="jobs-v2-field">
                <label for="jobType">Job type</label>
                <div class="jobs-v2-select">
                    <select id="jobType" name="jobType">
                        <option value="">Any job type</option>
                        <option value="Full-time" <%= jobType === "Full-time" ? "selected" : "" %>>Full-time</option>
                        <option value="Part-time" <%= jobType === "Part-time" ? "selected" : "" %>>Part-time</option>
                        <option value="Internship" <%= jobType === "Internship" ? "selected" : "" %>>Internship</option>
                        <option value="Contract" <%= jobType === "Contract" ? "selected" : "" %>>Contract</option>
                        <option value="Remote" <%= jobType === "Remote" ? "selected" : "" %>>Remote</option>
                    </select>
                </div>
            </div>

            <div class="jobs-v2-field">
                <label for="category">Category</label>
                <div class="jobs-v2-select">
                    <select id="category" name="category">
                        <option value="">Any category</option>
                        <option value="Software Development" <%= category === "Software Development" ? "selected" : "" %>>Software Development</option>
                        <option value="Data Science" <%= category === "Data Science" ? "selected" : "" %>>Data Science</option>
                        <option value="Web Development" <%= category === "Web Development" ? "selected" : "" %>>Web Development</option>
                        <option value="AI" <%= category === "AI" ? "selected" : "" %>>Artificial Intelligence</option>
                        <option value="Marketing" <%= category === "Marketing" ? "selected" : "" %>>Marketing</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="jobs-v2-search-btn">
                Search Jobs <span>→</span>
            </button>
        </form>
    </section>

    <!-- RESULTS -->
    <section class="jobs-v2-results">

        <div class="jobs-v2-results-heading">
            <div>
                <span class="jobs-v2-results-label">AVAILABLE ROLES</span>
                <h2>
                    <%= jobs.length %>
                    <span>opportunities</span>
                    <% if (keyword) { %>
                        for <strong><%= keyword %></strong>
                    <% } %>
                    <% if (location) { %>
                        in <strong><%= location %></strong>
                    <% } %>
                </h2>
            </div>

            <% if (jobType || category) { %>
                <a
                    href="/jobs?keyword=<%= encodeURIComponent(keyword || '') %>&location=<%= encodeURIComponent(location || '') %>"
                    class="jobs-v2-clear"
                >
                    Clear filters
                </a>
            <% } %>
        </div>

        <% if (jobs.length === 0) { %>

            <div class="jobs-v2-empty">
                <div class="jobs-v2-empty-icon">⌕</div>
                <h3>No opportunities found</h3>
                <p>Try another keyword or location, or remove one of your filters.</p>
                <a href="/jobs">Reset search</a>
            </div>

        <% } else { %>

            <div class="jobs-v2-layout">

                <!-- SIDEBAR -->
                <aside class="jobs-v2-sidebar">

                    <div class="jobs-v2-sidebar-head">
                        <div>
                            <span class="jobs-v2-filter-icon">☷</span>
                            <strong>Filters</strong>
                        </div>

                        <% if (jobType || category) { %>
                            <a href="/jobs?keyword=<%= encodeURIComponent(keyword || '') %>&location=<%= encodeURIComponent(location || '') %>">
                                Clear all
                            </a>
                        <% } %>
                    </div>

                    <div class="jobs-v2-filter-group">
                        <div class="jobs-v2-filter-title">
                            Job type <span>⌃</span>
                        </div>

                        <% const types = ["Full-time", "Part-time", "Internship", "Contract", "Remote"]; %>
                        <% types.forEach(type => { %>
                            <a
                                class="jobs-v2-check <%= jobType === type ? 'selected' : '' %>"
                                href="/jobs?keyword=<%= encodeURIComponent(keyword || '') %>&location=<%= encodeURIComponent(location || '') %>&jobType=<%= encodeURIComponent(type) %><%= category ? '&category=' + encodeURIComponent(category) : '' %>"
                            >
                                <span class="fake-check"><%= jobType === type ? '✓' : '' %></span>
                                <span><%= type %></span>
                            </a>
                        <% }) %>
                    </div>

                    <div class="jobs-v2-filter-group">
                        <div class="jobs-v2-filter-title">
                            Category <span>⌃</span>
                        </div>

                        <% const categories = [
                            ["Software Development", "Technology"],
                            ["Data Science", "Data & Analytics"],
                            ["Web Development", "Web Development"],
                            ["AI", "Artificial Intelligence"],
                            ["Marketing", "Marketing"]
                        ]; %>

                        <% categories.forEach(([value, label]) => { %>
                            <a
                                class="jobs-v2-check <%= category === value ? 'selected' : '' %>"
                                href="/jobs?keyword=<%= encodeURIComponent(keyword || '') %>&location=<%= encodeURIComponent(location || '') %>&category=<%= encodeURIComponent(value) %><%= jobType ? '&jobType=' + encodeURIComponent(jobType) : '' %>"
                            >
                                <span class="fake-check"><%= category === value ? '✓' : '' %></span>
                                <span><%= label %></span>
                            </a>
                        <% }) %>
                    </div>

                    <div class="jobs-v2-filter-group jobs-v2-location-filter">
                        <div class="jobs-v2-filter-title">
                            Location <span>⌃</span>
                        </div>

                        <div class="jobs-v2-mini-location">
                            <span>⌕</span>
                            <span><%= location || "Search location..." %></span>
                        </div>

                        <% const locations = ["India", "Remote", "Bangalore", "Mumbai", "Delhi", "Hyderabad"]; %>
                        <% locations.forEach(place => { %>
                            <a
                                class="jobs-v2-check <%= location.toLowerCase() === place.toLowerCase() ? 'selected' : '' %>"
                                href="/jobs?keyword=<%= encodeURIComponent(keyword || '') %>&location=<%= encodeURIComponent(place) %><%= jobType ? '&jobType=' + encodeURIComponent(jobType) : '' %><%= category ? '&category=' + encodeURIComponent(category) : '' %>"
                            >
                                <span class="fake-check"><%= location.toLowerCase() === place.toLowerCase() ? '✓' : '' %></span>
                                <span><%= place %></span>
                            </a>
                        <% }) %>
                    </div>

                </aside>

                <!-- JOBS -->
                <div class="jobs-v2-list">

                    <% jobs.forEach((job, index) => { %>

                        <article class="jobs-v2-card">

                            <div class="jobs-v2-company-icon">
                                <%= (job.company?.display_name || "J").charAt(0).toUpperCase() %>
                            </div>

                            <div class="jobs-v2-card-content">

                                <div class="jobs-v2-card-main">
                                    <div>
                                        <h3><%= job.title %></h3>

                                        <p class="jobs-v2-company">
                                            <%= job.company?.display_name || "Company not specified" %>
                                        </p>
                                    </div>

                                    <a
                                        class="jobs-v2-bookmark"
                                        href="/jobs/details?title=<%= encodeURIComponent(job.title) %>&company=<%= encodeURIComponent(job.company?.display_name || 'Company not specified') %>&location=<%= encodeURIComponent(job.location?.display_name || 'Location not specified') %>&description=<%= encodeURIComponent(job.description || '') %>&salaryMin=<%= job.salary_min || '' %>&salaryMax=<%= job.salary_max || '' %>&redirectUrl=<%= encodeURIComponent(job.redirect_url || '') %>"
                                        aria-label="View <%= job.title %>"
                                    >
                                        ♡
                                    </a>
                                </div>

                                <div class="jobs-v2-meta">
                                    <span>⌖ <%= job.location?.display_name || "Location not specified" %></span>
                                    <span>•</span>
                                    <span>External listing</span>
                                </div>

                                <div class="jobs-v2-tags">
                                    <% if (job.category) { %>
                                        <span><%= job.category %></span>
                                    <% } else { %>
                                        <span>Software Development</span>
                                    <% } %>

                                    <% if (jobType) { %>
                                        <span class="green"><%= jobType %></span>
                                    <% } %>
                                </div>

                                <p class="jobs-v2-description">
                                    <%= job.description
                                        ? (job.description.length > 180
                                            ? job.description.substring(0, 180) + "..."
                                            : job.description)
                                        : "View the complete job description and requirements."
                                    %>
                                </p>

                                <div class="jobs-v2-card-footer">
                                    <span class="jobs-v2-listed">External listing</span>

                                    <a
                                        href="/jobs/details?title=<%= encodeURIComponent(job.title) %>&company=<%= encodeURIComponent(job.company?.display_name || 'Company not specified') %>&location=<%= encodeURIComponent(job.location?.display_name || 'Location not specified') %>&description=<%= encodeURIComponent(job.description || '') %>&salaryMin=<%= job.salary_min || '' %>&salaryMax=<%= job.salary_max || '' %>&redirectUrl=<%= encodeURIComponent(job.redirect_url || '') %>"
                                        class="jobs-v2-view"
                                    >
                                        View details <span>→</span>
                                    </a>
                                </div>

                            </div>
                        </article>

                    <% }); %>

                </div>
            </div>

        <% } %>

    </section>

</main>

</body>
</html>
