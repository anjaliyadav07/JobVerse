<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Contact | JobVerse</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>


    <!-- ================= NAVBAR ================= -->

  <%- include("partials/navbar") %>



    <!-- ================= HERO ================= -->

    <section class="contact-hero">

        <span class="section-label">
            GET IN TOUCH
        </span>


        <h1>

            We'd love to

            <span>
                hear from you.
            </span>

        </h1>


        <p>

            Have a question, feedback, or something
            you'd like to share?

            Send us a message and we'll get back to you.

        </p>

    </section>



    <!-- ================= CONTACT ================= -->

    <section class="contact-section">


        <div class="contact-grid">


            <!-- LEFT SIDE -->

            <div class="contact-info">


                <span class="section-label">
                    CONTACT JOBVERSE
                </span>


                <h2>
                    Let's start a conversation.
                </h2>


                <p>

                    Whether you're looking for an opportunity,
                    hiring talent, or simply have a question,
                    we're here to help.

                </p>



                <div class="contact-info-list">


                    <div class="contact-info-item">

                        <div class="contact-info-icon">
                            ?
                        </div>


                        <div>

                            <span>
                                Questions
                            </span>

                            <strong>
                                We're here to help
                            </strong>

                        </div>

                    </div>



                    <div class="contact-info-item">

                        <div class="contact-info-icon">
                            ✦
                        </div>


                        <div>

                            <span>
                                Feedback
                            </span>

                            <strong>
                                Help us improve JobVerse
                            </strong>

                        </div>

                    </div>



                    <div class="contact-info-item">

                        <div class="contact-info-icon">
                            →
                        </div>


                        <div>

                            <span>
                                Opportunities
                            </span>

                            <strong>
                                Job seekers & employers
                            </strong>

                        </div>

                    </div>


                </div>


            </div>



            <!-- ================= FORM ================= -->

            <div class="contact-card">


                <form
                    action="/contact"
                    method="POST"
                    class="contact-form"
                >


                    <!-- NAME + EMAIL -->

                    <div class="contact-form-row">


                        <div class="form-group">

                            <label for="name">
                                Name
                            </label>


                            <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="Your name"
                                required
                            >

                        </div>



                        <div class="form-group">

                            <label for="email">
                                Email
                            </label>


                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="you@example.com"
                                required
                            >

                        </div>


                    </div>



                    <!-- SUBJECT -->

                    <div class="form-group">

                        <label for="subject">
                            Subject
                        </label>


                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            placeholder="How can we help?"
                            required
                        >

                    </div>



                    <!-- MESSAGE -->

                    <div class="form-group">

                        <label for="message">
                            Message
                        </label>


                        <textarea
                            id="message"
                            name="message"
                            rows="6"
                            placeholder="Tell us what's on your mind..."
                            required
                        ></textarea>

                    </div>



                    <!-- SUBMIT -->

                    <button
                        type="submit"
                        class="contact-submit"
                    >

                        Send Message →

                    </button>


                </form>


            </div>


        </div>


    </section>



    <!-- ================= FOOTER ================= -->

    <footer class="footer">


        <div class="footer-top">


            <!-- BRAND -->

            <div class="footer-brand">

                <a
                    href="/"
                    class="footer-logo"
                >

                    <img
                        src="/images/JobVerse-logo.png"
                        alt="JobVerse"
                    >

                </a>


                <p>
                    Where ambition meets opportunity.
                </p>

            </div>



            <!-- JOB SEEKERS -->

            <div class="footer-column">

                <h4>
                    For Job Seekers
                </h4>


                <a href="/jobs">
                    Find Jobs
                </a>


                <a href="/register">
                    Create Profile
                </a>


                <a href="/login">
                    Sign In
                </a>

            </div>



            <!-- EMPLOYERS -->

            <div class="footer-column">

                <h4>
                    For Employers
                </h4>


                <a href="/register?role=recruiter">
                    Post a Job
                </a>


                <a href="/register?role=recruiter">
                    Create Company
                </a>

            </div>



            <!-- JOBVERSE -->

            <div class="footer-column">

                <h4>
                    JobVerse
                </h4>


                <a href="/about">
                    About
                </a>


                <a href="/contact">
                    Contact
                </a>


                <a href="/privacy">
                    Privacy
                </a>

            </div>


        </div>



        <!-- FOOTER BOTTOM -->

        <div class="footer-bottom">

            <p>
                © 2026 JobVerse. All rights reserved.
            </p>


            <p>
                Built for people building their careers.
            </p>

        </div>


    </footer>


</body>

</html>