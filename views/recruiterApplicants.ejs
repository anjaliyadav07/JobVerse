<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Applicants | JobVerse</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>


    <!-- NAVBAR -->

   <%- include("partials/navbar") %>
        <!-- HEADER -->

        <div class="applicants-header">

            <div>

                <p class="dashboard-label">
                    RECRUITMENT
                </p>


                <h1>
                    Applicants
                </h1>


                <p>
                    Review candidates who applied to your jobs.
                </p>

            </div>


            <a
                href="/recruiter/dashboard"
                class="job-action-btn secondary"
            >
                ← Dashboard
            </a>

        </div>



        <!-- NO APPLICANTS -->

        <% if (applicants.length === 0) { %>


            <section class="empty-dashboard">

                <div class="empty-icon">
                    👥
                </div>


                <h3>
                    No applications yet
                </h3>


                <p>
                    Applications from candidates will appear here.
                </p>

            </section>


        <% } else { %>


            <!-- APPLICANTS -->

            <section class="applicants-list">


                <% applicants.forEach(applicant => { %>


                    <article class="applicant-card">


                        <!-- AVATAR -->

                        <div class="applicant-avatar">

                            <%= applicant.applicant_name
                                .charAt(0)
                                .toUpperCase()
                            %>

                        </div>



                        <!-- APPLICANT INFORMATION -->

                        <div class="applicant-info">


                            <h2>
                                <%= applicant.applicant_name %>
                            </h2>


                            <p class="applicant-email">

                                <%= applicant.applicant_email %>

                            </p>


                            <p class="applicant-job">

                                Applied for:

                                <strong>
                                    <%= applicant.job_title %>
                                </strong>

                            </p>


                            <p class="applicant-date">

                                Applied:

                                <%= new Date(
                                    applicant.applied_at
                                ).toLocaleDateString() %>

                            </p>



                            <!-- RESUME -->

                            <% if (applicant.resume_path) { %>

                                <a
                                    href="/<%= applicant.resume_path.replace(/\\/g, '/') %>"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="resume-link"
                                >
                                    📄 View Resume
                                </a>

                            <% } else { %>

                                <p class="no-resume">
                                    No resume uploaded
                                </p>

                            <% } %>


                        </div>



                        <!-- STATUS + ACTIONS -->

                        <div class="applicant-status">


                            <!-- STATUS -->

                            <span
                                class="status-badge <%= applicant.status %>"
                            >
                                <%= applicant.status %>
                            </span>



                            <!-- ACTION BUTTONS -->

                            <div class="applicant-actions">


                                <!-- SHORTLIST -->

                                <% if (
                                    applicant.status !== "shortlisted"
                                    &&
                                    applicant.status !== "hired"
                                ) { %>


                                    <form
                                        action="/recruiter/applications/<%= applicant.id %>/status"
                                        method="POST"
                                    >

                                        <input
                                            type="hidden"
                                            name="status"
                                            value="shortlisted"
                                        >


                                        <button
                                            type="submit"
                                            class="shortlist-btn"
                                        >
                                            Shortlist
                                        </button>

                                    </form>


                                <% } %>



                                <!-- REJECT -->

                                <% if (
                                    applicant.status !== "rejected"
                                    &&
                                    applicant.status !== "hired"
                                ) { %>


                                    <form
                                        action="/recruiter/applications/<%= applicant.id %>/status"
                                        method="POST"
                                    >

                                        <input
                                            type="hidden"
                                            name="status"
                                            value="rejected"
                                        >


                                        <button
                                            type="submit"
                                            class="reject-btn"
                                        >
                                            Reject
                                        </button>

                                    </form>


                                <% } %>



                                <!-- MARK HIRED -->

                                <% if (
                                    applicant.status === "shortlisted"
                                ) { %>


                                    <form
                                        action="/recruiter/applications/<%= applicant.id %>/status"
                                        method="POST"
                                    >

                                        <input
                                            type="hidden"
                                            name="status"
                                            value="hired"
                                        >


                                        <button
                                            type="submit"
                                            class="hire-btn"
                                        >
                                            Mark Hired
                                        </button>

                                    </form>


                                <% } %>


                            </div>


                        </div>


                    </article>


                <% }); %>


            </section>


        <% } %>


    </main>


</body>

</html>