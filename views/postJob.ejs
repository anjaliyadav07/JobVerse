<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Post a Job | JobVerse</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <nav class="navbar">

        <div class="logo">
            <a href="/">
                <img src="/images/jobverse-logo.png" alt="JobVerse">
            </a>
        </div>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/jobs">Find Jobs</a>
            <a href="/companies">Companies</a>
        </div>

    </nav>


    <main class="post-job-page">

        <section class="post-job-card">

            <p class="dashboard-label">RECRUITER</p>

            <h1>Post a new job</h1>

            <p class="post-job-subtitle">
                Find the right candidate for your team.
            </p>


            <form action="/recruiter/post-job" method="POST">


                <div class="form-group">

                    <label for="title">Job title</label>

                    <input
                        type="text"
                        id="title"
                        name="title"
                        placeholder="e.g. Frontend Developer"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="company_name">Company name</label>

                    <input
                        type="text"
                        id="company_name"
                        name="company_name"
                        placeholder="e.g. JobVerse Technologies"
                        required
                    >

                </div>


                <div class="form-group">

                    <label for="location">Location</label>

                    <input
                        type="text"
                        id="location"
                        name="location"
                        placeholder="e.g. Bangalore, India"
                        required
                    >

                </div>


                <div class="form-row">

                    <div class="form-group">

                        <label for="job_type">Job type</label>

                        <select id="job_type" name="job_type" required>

                            <option value="">Select job type</option>
                            <option value="Full-time">Full-time</option>
                            <option value="Part-time">Part-time</option>
                            <option value="Internship">Internship</option>
                            <option value="Contract">Contract</option>
                            <option value="Remote">Remote</option>

                        </select>

                    </div>


                    <div class="form-group">

                        <label for="category">Category</label>

                        <input
                            type="text"
                            id="category"
                            name="category"
                            placeholder="e.g. Software Development"
                            required
                        >

                    </div>

                </div>


                <div class="form-row">

                    <div class="form-group">

                        <label for="salary_min">Minimum salary</label>

                        <input
                            type="number"
                            id="salary_min"
                            name="salary_min"
                            placeholder="e.g. 500000"
                            min="0"
                        >

                    </div>


                    <div class="form-group">

                        <label for="salary_max">Maximum salary</label>

                        <input
                            type="number"
                            id="salary_max"
                            name="salary_max"
                            placeholder="e.g. 900000"
                            min="0"
                        >

                    </div>

                </div>


                <div class="form-group">

                    <label for="description">Job description</label>

                    <textarea
                        id="description"
                        name="description"
                        rows="8"
                        placeholder="Describe the role, responsibilities and requirements..."
                        required
                    ></textarea>

                </div>


                <button type="submit" class="post-job-btn">
                    Post Job
                </button>

            </form>

        </section>

    </main>

</body>

</html>