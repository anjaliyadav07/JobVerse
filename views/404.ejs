<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Page Not Found | JobVerse</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>


    <!-- NAVBAR -->

    <nav class="navbar">

        <a href="/" class="logo">

            <img
                src="/images/JobVerse-logo.png"
                alt="JobVerse"
            >

        </a>


        <div class="nav-links">

            <a href="/">Home</a>

            <a href="/jobs">Find Jobs</a>

            <a href="/companies">Companies</a>

            <a href="/about">About</a>

        </div>


        <div class="nav-actions">

            <a href="/login" class="login-btn">
                Log In
            </a>

            <a href="/register" class="signup-btn">
                Sign Up
            </a>

        </div>

    </nav>



    <!-- 404 -->

    <main class="error-page">

        <div class="error-glow"></div>


        <div class="error-content">

            <span class="error-code">
                404
            </span>


            <span class="section-label">
                PAGE NOT FOUND
            </span>


            <h1>
                Looks like this opportunity
                <span>doesn't exist.</span>
            </h1>


            <p>
                The page you're looking for may have been moved,
                removed, or the link might be incorrect.
            </p>


            <div class="error-actions">

                <a
                    href="/"
                    class="error-primary-btn"
                >
                    Back to Home →
                </a>


                <a
                    href="/jobs"
                    class="error-secondary-btn"
                >
                    Explore Jobs
                </a>

            </div>

        </div>

    </main>



    <!-- FOOTER -->

    <footer class="footer">

        <div class="footer-top">


            <div class="footer-brand">

                <a
                    href="/"
                    class="footer-logo"
                >

                    <img
                        src="/images/JobVerse-logo.png"
                        alt="JobVerse"
                    >

                </a>


                <p>
                    Where ambition meets opportunity.
                </p>

            </div>



            <div class="footer-column">

                <h4>
                    For Job Seekers
                </h4>

                <a href="/jobs">
                    Find Jobs
                </a>

                <a href="/register">
                    Create Profile
                </a>

                <a href="/login">
                    Sign In
                </a>

            </div>



            <div class="footer-column">

                <h4>
                    For Employers
                </h4>

                <a href="/register?role=recruiter">
                    Post a Job
                </a>

                <a href="/register?role=recruiter">
                    Create Company
                </a>

            </div>



            <div class="footer-column">

                <h4>
                    JobVerse
                </h4>

                <a href="/about">
                    About
                </a>

                <a href="/contact">
                    Contact
                </a>

            </div>


        </div>


        <div class="footer-bottom">

            <p>
                © 2026 JobVerse. All rights reserved.
            </p>


            <p>
                Built for people building their careers.
            </p>

        </div>

    </footer>


</body>

</html>