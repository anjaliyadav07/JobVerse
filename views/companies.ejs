<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Companies | JobVerse</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- ================= NAVBAR ================= -->
    <nav class="navbar">
        <a href="/" class="logo">
            <img src="/images/JobVerse-logo.png" alt="JobVerse">
        </a>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/jobs">Find Jobs</a>
            <a href="/companies" class="active">Companies</a>
            <a href="/about">About</a>
        </div>

        <div class="nav-actions">
            <a href="/login" class="login-btn">Log In</a>
            <a href="/register" class="signup-btn">Sign Up</a>
        </div>
    </nav>


    <!-- ================= HERO ================= -->
    <section class="companies-hero companies-hero-redesign">
        <div class="companies-hero-inner">

            <div class="companies-hero-copy">
                <span class="section-label">DISCOVER COMPANIES</span>

                <h1>
                    Find your next
                    <span>great company.</span>
                </h1>

                <p>
                    Explore companies hiring on JobVerse and discover
                    opportunities that match your career goals.
                </p>

                <div class="companies-hero-actions">
                    <a href="#company-list" class="companies-primary-btn">
                        Explore Companies <span>→</span>
                    </a>
                    <a href="/jobs" class="companies-secondary-btn">
                        Browse Jobs
                    </a>
                </div>

                <div class="companies-trust-row">
                    <div>
                        <strong><%= companies.length %>+</strong>
                        <span>Companies</span>
                    </div>
                    <div class="trust-divider"></div>
                    <div>
                        <strong>JobVerse</strong>
                        <span>Built for ambition</span>
                    </div>
                </div>
            </div>

            <div class="companies-hero-visual" aria-hidden="true">
                <div class="company-orbit orbit-a"></div>
                <div class="company-orbit orbit-b"></div>

                <div class="company-hero-card company-hero-card-main">
                    <div class="company-hero-card-top">
                        <div class="company-hero-logo">J</div>
                        <div>
                            <span class="company-card-kicker">FEATURED COMPANY</span>
                            <strong>Build your career</strong>
                        </div>
                        <span class="company-live-dot"></span>
                    </div>

                    <div class="company-hero-search">
                        <span>⌕</span>
                        <span>Search opportunities</span>
                    </div>

                    <div class="company-role-row">
                        <div>
                            <span>Frontend Developer</span>
                            <small>Remote · Full-time</small>
                        </div>
                        <span class="company-role-arrow">↗</span>
                    </div>

                    <div class="company-role-row">
                        <div>
                            <span>Software Engineer</span>
                            <small>India · Full-time</small>
                        </div>
                        <span class="company-role-arrow">↗</span>
                    </div>
                </div>

                <div class="company-floating-card company-floating-one">
                    <span class="floating-icon">✓</span>
                    <div>
                        <strong>Hiring now</strong>
                        <small>Fresh opportunities</small>
                    </div>
                </div>

                <div class="company-floating-card company-floating-two">
                    <span class="floating-icon">↗</span>
                    <div>
                        <strong>Explore roles</strong>
                        <small>Find your fit</small>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- ================= COMPANIES ================= -->
    <section class="companies-section companies-section-redesign" id="company-list">

        <% const showAll = view === "all"; %>
        <% const displayedCompanies = showAll ? companies : companies.slice(0, 6); %>

        <div class="companies-heading companies-heading-redesign">
            <div>
                <span class="section-label">COMPANIES ON JOBVERSE</span>
                <h2>Explore companies</h2>
                <p class="companies-heading-description">
                    Discover teams, industries and opportunities worth exploring.
                </p>
            </div>

            <div class="company-count-card">
                <strong><%= companies.length %></strong>
                <span><%= companies.length === 1 ? "company" : "companies" %> on JobVerse</span>
            </div>
        </div>

        <% if (companies.length === 0) { %>

            <div class="companies-empty companies-empty-redesign">
                <div class="companies-empty-icon">🏢</div>
                <h3>No companies found</h3>
                <p>
                    We couldn't find companies for this search.
                    Try exploring another job category.
                </p>
                <a href="/jobs" class="companies-empty-btn">Explore Jobs →</a>
            </div>

        <% } else { %>

            <div class="companies-grid companies-grid-redesign">

                <% displayedCompanies.forEach((company, index) => { %>

                    <article class="company-card company-card-redesign">

                        <div class="company-card-glow"></div>

                        <div class="company-card-top">
                            <div class="company-logo-placeholder">
                                <%= company.name
                                    ? company.name.charAt(0).toUpperCase()
                                    : "C"
                                %>
                            </div>

                            <span class="company-jobs">
                                <%= company.jobCount %>
                                <%= company.jobCount === 1 ? "Job" : "Jobs" %>
                            </span>
                        </div>

                        <div class="company-card-content">
                            <span class="company-index">0<%= index + 1 %></span>

                            <h3><%= company.name %></h3>

                            <p class="company-location">
                                <span>⌖</span>
                                <%= company.location || "India" %>
                            </p>

                            <p class="company-category">
                                <%= company.category || "Various industries" %>
                            </p>
                        </div>

                        <a
                            href="/jobs?keyword=<%= encodeURIComponent(company.name) %>&location=<%= encodeURIComponent(typeof location !== 'undefined' ? location : '') %>"
                            class="company-view-btn"
                        >
                            <span>View Jobs</span>
                            <span>→</span>
                        </a>
                    </article>

                <% }) %>
            </div>

            <% if (!showAll && companies.length > 6) { %>
                <div class="companies-view-all companies-view-all-redesign">
                    <a href="/companies?view=all">
                        View all <%= companies.length %> companies
                        <span>→</span>
                    </a>
                </div>
            <% } %>

        <% } %>
    </section>


    <!-- ================= EMPLOYER CTA ================= -->
    <section class="companies-cta companies-cta-redesign">
        <div class="companies-cta-glow"></div>

        <div class="companies-cta-content">
            <span class="section-label">FOR EMPLOYERS</span>

            <h2>
                Ready to find your
                <span>next hire?</span>
            </h2>

            <p>
                Create your company profile and start connecting
                with talented candidates.
            </p>

            <a href="/register?role=recruiter" class="companies-cta-btn">
                Start Hiring <span>→</span>
            </a>
        </div>
    </section>


    <!-- ================= FOOTER ================= -->
    <footer class="footer">
        <div class="footer-top">

            <div class="footer-brand">
                <a href="/" class="footer-logo">
                    <img src="/images/JobVerse-logo.png" alt="JobVerse">
                </a>
                <p>Where ambition meets opportunity.</p>
            </div>

            <div class="footer-column">
                <h4>For Job Seekers</h4>
                <a href="/jobs">Find Jobs</a>
                <a href="/register">Create Profile</a>
                <a href="/login">Sign In</a>
            </div>

            <div class="footer-column">
                <h4>For Employers</h4>
                <a href="/register?role=recruiter">Post a Job</a>
                <a href="/register?role=recruiter">Create Company</a>
            </div>

            <div class="footer-column">
                <h4>JobVerse</h4>
                <a href="/about">About</a>
                <a href="/contact">Contact</a>
                <a href="/privacy">Privacy</a>
            </div>
        </div>

        <div class="footer-bottom">
            <p>© 2026 JobVerse. All rights reserved.</p>
            <p>Built for people building their careers.</p>
        </div>
    </footer>

</body>
</html>
