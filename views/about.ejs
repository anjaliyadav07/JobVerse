            <div class="footer-brand">

                <a href="/" class="footer-logo">

                    <img
                        src="/images/JobVerse-logo.png"
                        alt="JobVerse"
                    >

                </a>

                <p>
                    Where ambition meets opportunity.
                </p>

            </div>


            <div class="footer-column">

                <h4>For Job Seekers</h4>

                <a href="/jobs">
                    Find Jobs
                </a>

                <a href="/register">
                    Create Profile
                </a>

                <a href="/login">
                    Sign In
                </a>

            </div>


            <div class="footer-column">

                <h4>For Employers</h4>

                <a href="/register?role=recruiter">
                    Post a Job
                </a>

                <a href="/register?role=recruiter">
                    Create Company
                </a>

            </div>


            <div class="footer-column">

                <h4>JobVerse</h4>

                <a href="/about">
                    About
                </a>

                <a href="/contact">
                    Contact
                </a>

                <a href="/privacy">
                    Privacy
                </a>

            </div>

        </div>


        <div class="footer-bottom">

            <p>
                © 2026 JobVerse. All rights reserved.
            </p>

            <p>
                Built for people building their careers.
            </p>

        </div>

    </footer>

</body>
</html>