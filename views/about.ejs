<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>About | JobVerse</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* =========================================================
           JOBVERSE — ABOUT PAGE FINAL
           ========================================================= */

        .about-v2 {
            background: #ffffff;
            color: #111827;
        }

        .about-v2 * {
            box-sizing: border-box;
        }

        /* ---------- MISSION ---------- */

        .jv-mission {
            position: relative;
            overflow: hidden;
            padding:  35px 7% 28px;
            background:
                radial-gradient(
                    circle at 78% 25%,
                    rgba(37, 99, 235, 0.10),
                    transparent 28%
                ),
                #ffffff;
        }

        .jv-mission-inner {
            max-width: 1240px;
            margin: 0 auto;
        }

        .jv-mission-grid {
            display: grid;
            grid-template-columns: 1fr 0.9fr;
            align-items: center;
            gap: 65px;
        }

        .jv-eyebrow {
            display: inline-block;
            margin-bottom: 18px;
            color: #64748b;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .jv-mission-copy h1 {
            max-width: 650px;
            margin: 0;
            font-size: clamp(2.5rem, 3.2vw, 3.35rem);
            line-height: 0.98;
            letter-spacing: -0.055em;
            font-weight: 800;
            color: #111827;
        }

        .jv-mission-copy h1 span {
            color: #2563eb;
        }

        .jv-divider {
            width: 34px;
            height: 2px;
            margin: 26px 0 24px;
            background: #2563eb;
        }

        .jv-mission-copy p {
            max-width: 620px;
            margin: 0 0 18px;
            color: #64748b;
            font-size: 1rem;
            line-height: 1.75;
        }


        /* ---------- PRODUCT VISUAL ---------- */

        .jv-product-visual {
            position: relative;
            min-height: 410px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .jv-visual-glow {
            position: absolute;
            width: 330px;
            height: 330px;
            border-radius: 50%;
            background: rgba(37, 99, 235, 0.08);
            filter: blur(2px);
        }

        .jv-orbit {
            position: absolute;
            width: 330px;
            height: 330px;
            border: 1px solid rgba(37, 99, 235, 0.16);
            border-radius: 50%;
        }

        .jv-orbit::after {
            content: "";
            position: absolute;
            inset: 28px;
            border: 1px dashed rgba(37, 99, 235, 0.16);
            border-radius: 50%;
        }

        .jv-main-card {
            position: relative;
            z-index: 2;
            width: 315px;
            padding: 28px;
            border: 1px solid #e3eaf5;
            border-radius: 22px;
            background: rgba(255, 255, 255, 0.97);
            box-shadow:
                0 25px 60px rgba(37, 99, 235, 0.13),
                0 8px 25px rgba(15, 23, 42, 0.06);
        }

        .jv-card-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 22px;
        }

        .jv-card-brand img {
            width: 42px;
            height: auto;
        }

        .jv-card-brand strong {
            display: block;
            font-size: 1.05rem;
            color: #111827;
        }

        .jv-card-brand span {
            display: block;
            margin-top: 2px;
            color: #64748b;
            font-size: 0.68rem;
        }

        .jv-search {
            display: flex;
            align-items: center;
            gap: 9px;
            height: 42px;
            padding: 0 13px;
            margin-bottom: 19px;
            border: 1px solid #e5eaf2;
            border-radius: 11px;
            background: #f8faff;
            color: #94a3b8;
            font-size: 0.78rem;
        }

        .jv-search-icon {
            color: #2563eb;
            font-size: 1rem;
        }

        .jv-card-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .jv-card-item {
            display: flex;
            align-items: center;
            gap: 11px;
            color: #1e293b;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .jv-card-item-icon {
            width: 27px;
            height: 27px;
            display: grid;
            place-items: center;
            border-radius: 8px;
            background: #eff6ff;
            color: #2563eb;
            font-size: 0.8rem;
        }

        /* Floating cards */

        .jv-float {
            position: absolute;
            z-index: 3;
            min-width: 145px;
            padding: 13px 15px;
            border: 1px solid rgba(226, 232, 240, 0.95);
            border-radius: 15px;
            background: rgba(255,255,255,0.95);
            box-shadow: 0 15px 35px rgba(15, 23, 42, 0.10);
        }

        .jv-float strong {
            display: block;
            color: #111827;
            font-size: 0.9rem;
        }

        .jv-float span {
            display: block;
            margin-top: 3px;
            color: #64748b;
            font-size: 0.68rem;
        }

        .jv-float-one {
            top: 20px;
            left: 3%;
        }

        .jv-float-two {
            top: 45px;
            right: 0;
        }

        .jv-float-three {
            right: 1%;
            bottom: 32px;
        }

        .jv-float-one::before,
        .jv-float-two::before,
        .jv-float-three::before {
            content: "";
            display: inline-block;
            width: 25px;
            height: 25px;
            margin-bottom: 6px;
            border-radius: 8px;
            background: #eff6ff;
        }

        .jv-float-two::before {
            background: #ecfdf5;
        }

        .jv-float-three::before {
            background: #f3e8ff;
        }


        /* ---------- STATS ---------- */

        .jv-stats {
            max-width: 1240px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            border-top: 1px solid #e5eaf2;
            padding-top: 25px;
        }

        .jv-stat {
            text-align: center;
            padding: 5px 20px;
            border-right: 1px solid #dce5f1;
        }

        .jv-stat:last-child {
            border-right: none;
        }

        .jv-stat strong {
            display: block;
            color: #2563eb;
            font-size: 1.9rem;
            line-height: 1;
            letter-spacing: -0.04em;
        }

        .jv-stat span {
            display: block;
            margin-top: 7px;
            color: #64748b;
            font-size: 0.82rem;
        }


        /* ---------- WHAT WE DO ---------- */

        .jv-what {
            padding: 65px 7px 72px;
            padding-left: 7%;
            padding-right: 7%;
            background: #f6f9ff;
            border-top: 1px solid #edf2f8;
            border-bottom: 1px solid #edf2f8;
        }

        .jv-section-heading {
            max-width: 800px;
            margin: 0 auto 38px;
            text-align: center;
        }

        .jv-section-heading h2 {
            margin: 8px 0 10px;
            font-size: clamp(2.1rem, 4vw, 3.4rem);
            line-height: 1.02;
            letter-spacing: -0.05em;
            color: #111827;
        }

        .jv-section-heading h2 span {
            color: #2563eb;
        }

        .jv-section-heading p {
            margin: 0;
            color: #64748b;
            font-size: 0.95rem;
        }

        .jv-side-grid {
            max-width: 1080px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 24px;
        }

        .jv-side-card {
            position: relative;
            overflow: hidden;
            min-height: 190px;
            padding: 27px 30px;
            border: 1px solid #dfe7f3;
            border-radius: 18px;
            background: white;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.035);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .jv-side-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 18px 35px rgba(37, 99, 235, 0.08);
        }

        .jv-side-card::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            right: -55px;
            top: -55px;
            border-radius: 50%;
            background: #eef4ff;
        }

        .jv-side-card.employer::after {
            background: #ecfdf5;
        }

        .jv-side-number {
            position: absolute;
            top: 24px;
            right: 25px;
            z-index: 2;
            color: #2563eb;
            font-size: 0.75rem;
            font-weight: 800;
        }

        .jv-side-icon {
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            margin-bottom: 18px;
            border-radius: 14px;
            background: #eff6ff;
            color: #2563eb;
            font-size: 1.3rem;
        }

        .jv-side-card.employer .jv-side-icon {
            background: #ecfdf5;
            color: #16a34a;
        }

        .jv-side-card h3 {
            margin: 0 0 8px;
            font-size: 1.25rem;
            color: #111827;
        }

        .jv-side-card p {
            max-width: 470px;
            margin: 0;
            color: #64748b;
            font-size: 0.9rem;
            line-height: 1.65;
        }


        /* ---------- HOW IT WORKS ---------- */

        .jv-process {
            padding: 68px 7% 75px;
            background: #ffffff;
        }

        .jv-process-grid {
            max-width: 1080px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
        }

        .jv-process-card {
            position: relative;
            padding: 25px;
            border: 1px solid #e1e8f2;
            border-radius: 17px;
            background: white;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

        .jv-process-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 35px rgba(37, 99, 235, 0.08);
        }

        .jv-process-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 22px;
        }

        .jv-step-number {
            color: #2563eb;
            font-size: 0.8rem;
            font-weight: 800;
        }

        .jv-process-icon {
            width: 45px;
            height: 45px;
            display: grid;
            place-items: center;
            border-radius: 13px;
            background: #eff6ff;
            color: #2563eb;
            font-size: 1.15rem;
        }

        .jv-process-card h3 {
            margin: 0 0 8px;
            font-size: 1.12rem;
            color: #111827;
        }

        .jv-process-card p {
            margin: 0;
            color: #64748b;
            font-size: 0.86rem;
            line-height: 1.65;
        }

        /* Small connector on desktop */

        .jv-process-card:not(:last-child)::after {
            content: "→";
            position: absolute;
            z-index: 3;
            right: -24px;
            top: 50%;
            transform: translateY(-50%);
            color: #2563eb;
            font-size: 1rem;
        }




        /* ---------- RESPONSIVE ---------- */

        @media (max-width: 1000px) {

            .jv-mission-grid {
                grid-template-columns: 1fr;
                gap: 25px;
            }

            .jv-product-visual {
                min-height: 380px;
            }

            .jv-mission-copy {
                text-align: center;
            }

            .jv-mission-copy h1,
            .jv-mission-copy p {
                margin-left: auto;
                margin-right: auto;
            }

            .jv-divider {
                margin-left: auto;
                margin-right: auto;
            }
        }


        @media (max-width: 800px) {

            .jv-mission {
                padding: 55px 6% 35px;
            }

            .jv-mission-copy h1 {
                font-size: clamp(2.7rem, 9vw, 4rem);
            }

            .jv-stats {
                grid-template-columns: repeat(2, 1fr);
                row-gap: 20px;
            }

            .jv-stat:nth-child(2) {
                border-right: none;
            }

            .jv-side-grid {
                grid-template-columns: 1fr;
            }

            .jv-process-grid {
                grid-template-columns: 1fr;
            }

            .jv-process-card:not(:last-child)::after {
                display: none;
            }

            .jv-what,
            .jv-process {
                padding-left: 6%;
                padding-right: 6%;
            }
        }


        @media (max-width: 600px) {

            .jv-mission-copy h1 {
                font-size: 2.65rem;
            }

            .jv-mission-copy p {
                font-size: 0.92rem;
            }

            .jv-product-visual {
                min-height: 350px;
                transform: scale(0.9);
                margin: -15px 0;
            }

            .jv-main-card {
                width: 280px;
            }

            .jv-float-one {
                left: -5px;
            }

            .jv-float-two {
                right: -5px;
            }

            .jv-float-three {
                right: 0;
            }

            .jv-stats {
                grid-template-columns: 1fr 1fr;
                padding: 20px 4%;
            }

            .jv-stat {
                padding: 8px;
                border-right: none;
            }

            .jv-stat strong {
                font-size: 1.55rem;
            }

            .jv-stat span {
                font-size: 0.72rem;
            }

            .jv-what {
                padding-top: 55px;
                padding-bottom: 60px;
            }

            .jv-section-heading h2 {
                font-size: 2.25rem;
            }

            .jv-side-card {
                padding: 24px;
            }

            .jv-process {
                padding-top: 55px;
            }
        }
    </style>
</head>

<body class="about-v2">

    <!-- =========================================================
         NAVBAR
         ========================================================= -->

    <nav class="navbar">

        <a href="/" class="logo">
            <img src="/images/JobVerse-logo.png" alt="JobVerse">
        </a>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/jobs">Find Jobs</a>
            <a href="/companies">Companies</a>
            <a href="/about" class="active">About</a>
        </div>

        <div class="nav-actions">
            <a href="/login" class="login-btn">Log In</a>
            <a href="/register" class="signup-btn">Sign Up</a>
        </div>

    </nav>


    <!-- =========================================================
         OUR MISSION
         ========================================================= -->

    <main>

        <section class="jv-mission">

            <div class="jv-mission-inner">

                <div class="jv-mission-grid">

                    <!-- LEFT -->

                    <div class="jv-mission-copy">

                        <span class="jv-eyebrow">
                            OUR MISSION
                        </span>

                        <h1>
                            Making the journey
                            <span>to the right opportunity simpler.</span>
                        </h1>

                        <div class="jv-divider"></div>

                        <p>
                            Finding a job shouldn't feel complicated.
                            JobVerse brings job discovery, applications,
                            and career opportunities together in one place.
                        </p>

                        <p>
                            For employers, JobVerse makes it easier to publish
                            opportunities and connect with candidates who are
                            ready for their next move.
                        </p>

                    </div>


                    <!-- RIGHT PRODUCT VISUAL -->

                    <div class="jv-product-visual">

                        <div class="jv-visual-glow"></div>

                        <div class="jv-orbit"></div>


                        <!-- MAIN CARD -->

                        <div class="jv-main-card">

                            <div class="jv-card-brand">

                                <img
                                    src="/images/JobVerse-logo.png"
                                    alt="JobVerse"
                                >

                                <div>
                                    <strong>JobVerse</strong>
                                    <span>Discover. Apply. Grow.</span>
                                </div>

                            </div>


                            <div class="jv-search">

                                <span class="jv-search-icon">
                                    ⌕
                                </span>

                                <span>
                                    Search jobs, companies...
                                </span>

                            </div>


                            <div class="jv-card-list">

                                <div class="jv-card-item">

                                    <span class="jv-card-item-icon">
                                        💼
                                    </span>

                                    Find your next role

                                </div>


                                <div class="jv-card-item">

                                    <span class="jv-card-item-icon">
                                        ▦
                                    </span>

                                    Explore top companies

                                </div>


                                <div class="jv-card-item">

                                    <span class="jv-card-item-icon">
                                        ↗
                                    </span>

                                    Grow your career

                                </div>

                            </div>

                        </div>


                        <!-- FLOATING CARD 1 -->

                        <div class="jv-float jv-float-one">

                            <strong>10K+</strong>

                            <span>
                                Active Jobs
                            </span>

                        </div>


                        <!-- FLOATING CARD 2 -->

                        <div class="jv-float jv-float-two">

                            <strong>500+</strong>

                            <span>
                                Companies
                            </span>

                        </div>


                        <!-- FLOATING CARD 3 -->

                        <div class="jv-float jv-float-three">

                            <strong>25K+</strong>

                            <span>
                                Job Seekers
                            </span>

                        </div>

                    </div>

                </div>


                <!-- STATS -->

                <div class="jv-stats">

                    <div class="jv-stat">
                        <strong>10K+</strong>
                        <span>Active Jobs</span>
                    </div>

                    <div class="jv-stat">
                        <strong>500+</strong>
                        <span>Companies</span>
                    </div>

                    <div class="jv-stat">
                        <strong>25K+</strong>
                        <span>Job Seekers</span>
                    </div>

                    <div class="jv-stat">
                        <strong>24/7</strong>
                        <span>Opportunity Discovery</span>
                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             WHAT WE DO
             ===================================================== -->

        <section class="jv-what">

            <div class="jv-section-heading">

                <span class="jv-eyebrow">
                    WHAT WE DO
                </span>

                <h2>
                    One platform.
                    <span>Two sides of opportunity.</span>
                </h2>

                <p>
                    JobVerse is designed to make both sides of hiring
                    simpler and more connected.
                </p>

            </div>


            <div class="jv-side-grid">

                <!-- JOB SEEKERS -->

                <article class="jv-side-card">

                    <span class="jv-side-number">
                        01
                    </span>

                    <div class="jv-side-icon">
                        ◎
                    </div>

                    <h3>
                        For Job Seekers
                    </h3>

                    <p>
                        Discover jobs that match your skills, interests,
                        and goals. Apply easily and take the next step
                        towards a better career.
                    </p>

                </article>


                <!-- EMPLOYERS -->

                <article class="jv-side-card employer">

                    <span class="jv-side-number">
                        02
                    </span>

                    <div class="jv-side-icon">
                        ↗
                    </div>

                    <h3>
                        For Employers
                    </h3>

                    <p>
                        Create your company presence, publish job openings,
                        and connect with talented candidates who are ready
                        to make an impact.
                    </p>

                </article>

            </div>

        </section>


        <!-- =====================================================
             HOW JOBVERSE WORKS
             ===================================================== -->

        <section class="jv-process">

            <div class="jv-section-heading">

                <span class="jv-eyebrow">
                    HOW JOBVERSE WORKS
                </span>

                <h2>
                    From discovery
                    <span>to opportunity.</span>
                </h2>

                <p>
                    A simple and powerful way to find the right opportunities.
                </p>

            </div>


            <div class="jv-process-grid">

                <!-- CREATE -->

                <article class="jv-process-card">

                    <div class="jv-process-top">

                        <span class="jv-step-number">
                            01
                        </span>

                        <div class="jv-process-icon">
                            ◎
                        </div>

                    </div>

                    <h3>
                        Create
                    </h3>

                    <p>
                        Build your professional profile and showcase
                        your skills and experience.
                    </p>

                </article>


                <!-- DISCOVER -->

                <article class="jv-process-card">

                    <div class="jv-process-top">

                        <span class="jv-step-number">
                            02
                        </span>

                        <div class="jv-process-icon">
                            ⌕
                        </div>

                    </div>

                    <h3>
                        Discover
                    </h3>

                    <p>
                        Search and explore opportunities that match
                        what you're looking for.
                    </p>

                </article>


                <!-- APPLY -->

                <article class="jv-process-card">

                    <div class="jv-process-top">

                        <span class="jv-step-number">
                            03
                        </span>

                        <div class="jv-process-icon">
                            ↗
                        </div>

                    </div>

                    <h3>
                        Apply
                    </h3>

                    <p>
                        Apply to the roles that interest you and
                        keep track of your applications.
                    </p>

                </article>

            </div>

        </section>

    </main>


