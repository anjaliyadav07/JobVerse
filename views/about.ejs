<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>About | JobVerse</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar">

        <a href="/" class="logo">
            <img src="/images/JobVerse-logo.png" alt="JobVerse">
        </a>

        <div class="nav-links">
            <a href="/">Home</a>
            <a href="/jobs">Find Jobs</a>
            <a href="/companies">Companies</a>
            <a href="/about" class="active">About</a>
        </div>

        <div class="nav-actions">
            <a href="/login" class="login-btn">Log In</a>
            <a href="/register" class="signup-btn">Sign Up</a>
        </div>

    </nav>


    <!-- ABOUT HERO -->
    <section class="about-hero">

        <div class="about-hero-glow"></div>

        <div class="about-hero-content">

            <span class="section-label">ABOUT JOBVERSE</span>

            <h1>
                Where ambition
                <span>meets opportunity.</span>
            </h1>

            <p>
                JobVerse connects talented people with meaningful
                opportunities and helps companies discover the people
                who can move their teams forward.
            </p>

            <div class="about-hero-actions">
                <a href="/jobs" class="about-primary-btn">
                    Explore Jobs →
                </a>

                <a href="/register?role=recruiter" class="about-secondary-btn">
                    Start Hiring
                </a>
            </div>

        </div>

    </section>


    <!-- MISSION -->
    <section class="about-mission">

        <div class="about-section-label">
            <span class="section-label">OUR MISSION</span>
        </div>

        <div class="about-mission-grid">

            <div>
                <h2>
                    Making the journey
                    <span>to the right opportunity simpler.</span>
                </h2>
            </div>

            <div>
                <p>
                    Finding a job shouldn't feel complicated.
                    JobVerse brings job discovery, applications,
                    and career opportunities together in one place.
                </p>

                <p>
                    For employers, JobVerse makes it easier to publish
                    opportunities and connect with candidates who are
                    ready for their next move.
                </p>
            </div>

        </div>

    </section>


    <!-- STATS -->
    <section class="about-stats">

        <div class="about-stat">
            <strong>10K+</strong>
            <span>Active Jobs</span>
        </div>

        <div class="about-stat">
            <strong>500+</strong>
            <span>Companies</span>
        </div>

        <div class="about-stat">
            <strong>25K+</strong>
            <span>Job Seekers</span>
        </div>

        <div class="about-stat">
            <strong>24/7</strong>
            <span>Opportunity Discovery</span>
        </div>

    </section>


    <!-- WHAT WE DO -->
    <section class="about-features">

        <div class="section-center">

            <span class="section-label">WHAT WE DO</span>

            <h2>
                One platform.
                <span>Two sides of opportunity.</span>
            </h2>

            <p>
                JobVerse is designed to make both sides of hiring
                simpler and more connected.
            </p>

        </div>


        <div class="about-feature-grid">

            <!-- JOB SEEKERS -->
            <div class="about-feature-card">

                <div class="about-feature-icon">
                    ⌕
                </div>

                <span class="about-feature-number">01</span>

                <h3>For Job Seekers</h3>

                <p>
                    Discover jobs that match your skills, interests,
                    and goals. Build your profile, apply to opportunities,
                    and keep track of your applications.
                </p>

                <a href="/jobs">
                    Find Jobs →
                </a>

            </div>


            <!-- EMPLOYERS -->
            <div class="about-feature-card">

                <div class="about-feature-icon">
                    ↗
                </div>

                <span class="about-feature-number">02</span>

                <h3>For Employers</h3>

                <p>
                    Create your company presence, publish job openings,
                    and connect with candidates looking for their next
                    career opportunity.
                </p>

                <a href="/register?role=recruiter">
                    Start Hiring →
                </a>

            </div>

        </div>

    </section>


    <!-- HOW IT WORKS -->
    <section class="about-process">

        <div class="section-center">

            <span class="section-label">HOW JOBVERSE WORKS</span>

            <h2>
                From discovery
                <span>to opportunity.</span>
            </h2>

        </div>


        <div class="about-process-grid">

            <div class="about-process-item">

                <span>01</span>

                <div class="about-process-icon">
                    ◎
                </div>

                <h3>Create</h3>

                <p>
                    Build your professional profile and showcase
                    your skills and experience.
                </p>

            </div>


            <div class="about-process-item">

                <span>02</span>

                <div class="about-process-icon">
                    ⌕
                </div>

                <h3>Discover</h3>

                <p>
                    Search and explore opportunities that match
                    what you're looking for.
                </p>

            </div>


            <div class="about-process-item">

                <span>03</span>

                <div class="about-process-icon">
                    ↗
                </div>

                <h3>Apply</h3>

                <p>
                    Apply to the roles that interest you and
                    keep track of your applications.
                </p>

            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="about-cta">

        <div class="about-cta-glow"></div>

        <div class="about-cta-content">

            <span class="section-label">YOUR NEXT MOVE</span>

            <h2>
                Ready to find what's
                <span>next?</span>
            </h2>

            <p>
                Whether you're looking for your next opportunity
                or your next great hire, JobVerse is here to help.
            </p>

            <div class="about-cta-actions">

                <a href="/jobs" class="about-cta-primary">
                    Find Your Next Job →
                </a>

                <a href="/register?role=recruiter" class="about-cta-secondary">
                    Hire Talent
                </a>

            </div>

        </div>

    </section>


    <!-- FOOTER -->
    <footer class="footer">

        <div class="footer-top">

            <div class="footer-brand">

                <a href="/" class="footer-logo">
                    <img src="/images/JobVerse-logo.png" alt="JobVerse">
                </a>

                <p>
                    Where ambition meets opportunity.
                </p>

            </div>


            <div class="footer-column">

                <h4>For Job Seekers</h4>

                <a href="/jobs">Find Jobs</a>
                <a href="/register">Create Profile</a>
                <a href="/login">Sign In</a>

            </div>


            <div class="footer-column">

                <h4>For Employers</h4>

                <a href="/register?role=recruiter">Post a Job</a>
                <a href="/register?role=recruiter">Create Company</a>

            </div>


            <div class="footer-column">

                <h4>JobVerse</h4>

                <a href="/about">About</a>
                <a href="/contact">Contact</a>
                <a href="/privacy">Privacy</a>

            </div>

        </div>


        <div class="footer-bottom">

            <p>© 2026 JobVerse. All rights reserved.</p>

            <p>Built for people building their careers.</p>

        </div>

    </footer>


</body>
</html>